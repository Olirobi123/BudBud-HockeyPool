# Copy this file to .env and fill in the values below.

# --- Server ---

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/budbud

# Port the Express server listens on (optional, defaults to 5000)
PORT=5000

# Environment mode
NODE_ENV=development

# Comma-separated list of allowed CORS origins (optional).
# Leave empty or set to "*" to allow all origins.
# e.g. http://localhost:5173,https://my-frontend.vercel.app
ALLOWED_ORIGINS=

# Secret token required to call /api/snapshot cron endpoints (requireApiKey middleware)
CRON_API_TOKEN=

# --- Client ---

# Backend API base URL used by the frontend (Vite)
VITE_BACKEND_URL=http://localhost:5000
