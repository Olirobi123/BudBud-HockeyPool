{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint", "import"],
  "extends": [
    "plugin:@typescript-eslint/recommended",
    // Must stay last: switches off every formatting-only rule.
    "prettier"
  ],
  "parserOptions": {
    "project": "./tsconfig.json",
    "ecmaVersion": 2020,
    "sourceType": "module"
  },
  "env": {
    "node": true,
    "es2021": true
  },
  "settings": {
    // See the note in client/.eslintrc.json: without a TypeScript-aware
    // resolver, import/extensions cannot resolve .ts files and reports every
    // extensionless relative import as "Missing file extension".
    "import/resolver": {
      "typescript": {
        "project": "./tsconfig.json",
        "alwaysTryTypes": true
      },
      "node": {
        "extensions": [".ts", ".js", ".json"]
      }
    }
  },
  "rules": {
    "@typescript-eslint/no-explicit-any": "error",
    // Express identifies error handlers by arity, so unused-but-required
    // parameters are marked with a leading underscore rather than removed.
    "@typescript-eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],

    // tsc --noEmit (npm run check) already infers and checks every return type.
    "@typescript-eslint/explicit-module-boundary-types": "off",
    // Not part of recommended; bans truthiness checks on strings/numbers.
    "@typescript-eslint/strict-boolean-expressions": "off",

    "import/extensions": [
      "error",
      "ignorePackages",
      {
        "ts": "never",
        "js": "never"
      }
    ]
  }
}
